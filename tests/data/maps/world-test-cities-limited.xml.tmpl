<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE Map[]>
<Map srs="{{ web_mercator_srs }}" minimum-version="0.7.2" buffer-size="128" maximum-extent="-20037508.34,-20037508.34,20037508.34,20037508.34">
